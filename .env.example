# The Next.js app is a static export with no backend of its own — form
# submissions go to a separate Lambda. See lambda/.env.example for its vars
# (Notion API key + data source ID), which live in AWS Secrets Manager in
# production, not here.

# Google Tag Manager container ID. Optional — defaults to GTM-PXLD8M6
# (production) in lib/analytics.ts if unset. Only loads after the visitor
# accepts the cookie-consent banner (components/Analytics.tsx).
NEXT_PUBLIC_GTM_ID=
