# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
lambda/node_modules
lambda/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# previous Next.js output
/.next/
/out/

# React Router generated types
/.react-router/

# generated at build time from lib/industries.ts, see scripts/generate-sitemap.ts
/public/sitemap.xml

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
