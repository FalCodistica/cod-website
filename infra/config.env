# ─── Codistica website - infrastructure configuration ───────────────────────
# Single source of truth for every resource name, the domain, and the region.
# Edit the values below, then run:  ./deploy.sh
# ─────────────────────────────────────────────────────────────────────────────

# AWS CLI profile for all local operations (deploy.sh / publish.sh).
# Leave blank to use your default profile.
#
# NOTE: this must resolve to AWS account 509561305736 - the same account
# eledatic-landing deploys to (per its bucket name). No profile named
# "codistica" exists on every machine by default; set one up (SSO or static
# credentials) pointed at that account before running deploy.sh.
AWS_PROFILE=codistica

# AWS region for the S3 buckets + Lambda + main stack.
# NOTE: the TLS certificate is ALWAYS created in us-east-1 as well - a hard
# CloudFront requirement - this is handled automatically by deploy.sh.
AWS_REGION=eu-west-1

# ── Resource names ──────────────────────────────────────────────────────────
PROJECT_NAME=codistica-website                        # CloudFormation stack name + tag
BUCKET_NAME=codistica-website-509561305736             # must be globally unique across ALL of AWS
CV_UPLOADS_BUCKET_NAME=codistica-website-cv-uploads-509561305736  # must be globally unique
DEPLOY_ROLE_NAME=codistica-website-deploy              # IAM role assumed by GitHub Actions
OAC_NAME=codistica-website-oac                         # CloudFront Origin Access Control (S3)
LAMBDA_OAC_NAME=codistica-website-lambda-oac           # CloudFront Origin Access Control (Lambda)
LAMBDA_FUNCTION_NAME=codistica-website-submissions     # form-submissions Lambda
SECRET_NAME=codistica-website/submissions              # Secrets Manager secret (Notion creds)
CV_RETENTION_DAYS=3                                    # days a CV stays in staging before expiry

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN_NAME=codistica.com
INCLUDE_WWW=true                                 # also serve www.codistica.com, redirected to apex
HOSTED_ZONE_ID=                                  # REQUIRED - fill this in (command below)

# ── GitHub (scopes the OIDC deploy role to this repo) ───────────────────────
GITHUB_ORG=codistica
GITHUB_REPO=cod-website

# ── OIDC ────────────────────────────────────────────────────────────────────
# eledatic-landing's account already has the GitHub OIDC provider, so reuse it
# (don't recreate) - set to "true" only for a genuinely fresh account.
CREATE_OIDC_PROVIDER=false

# ── CloudFront ──────────────────────────────────────────────────────────────
# PriceClass_100 = NA + EU (cheapest), _200 = + Asia, _All = all global edges.
PRICE_CLASS=PriceClass_100

# Find HOSTED_ZONE_ID with:
#   aws route53 list-hosted-zones-by-name --dns-name codistica.com \
#     --query 'HostedZones[0].Id' --output text
